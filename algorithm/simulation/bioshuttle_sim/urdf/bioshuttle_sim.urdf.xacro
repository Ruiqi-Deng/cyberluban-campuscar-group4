<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="bioshuttle">

  <!-- Keep these dimensions aligned with the real chassis description. -->
  <xacro:property name="PI_VALUE" value="3.141592653589793"/>
  <xacro:property name="base_length" value="0.60"/>
  <xacro:property name="base_width" value="0.45"/>
  <xacro:property name="base_height" value="0.10"/>
  <xacro:property name="base_mass" value="10.0"/>
  <xacro:property name="wheel_radius" value="0.0825"/>
  <xacro:property name="wheel_width" value="0.055"/>
  <xacro:property name="wheel_mass" value="1.5"/>
  <xacro:property name="axle_x" value="0.20"/>
  <xacro:property name="axle_y" value="0.225"/>

  <material name="bioshuttle_blue"><color rgba="0.08 0.34 0.72 1"/></material>
  <material name="lid_blue"><color rgba="0.20 0.55 0.92 1"/></material>
  <material name="dark"><color rgba="0.04 0.04 0.05 1"/></material>
  <material name="sensor_black"><color rgba="0.08 0.08 0.09 1"/></material>
  <material name="camera_glass"><color rgba="0.05 0.12 0.18 1"/></material>

  <xacro:macro name="box_inertia" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0"/>
      <inertia
        ixx="${mass * (y*y + z*z) / 12.0}" ixy="0" ixz="0"
        iyy="${mass * (x*x + z*z) / 12.0}" iyz="0"
        izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel_inertia" params="mass radius width">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0"/>
      <inertia
        ixx="${mass * (3*radius*radius + width*width) / 12.0}" ixy="0" ixz="0"
        iyy="${mass * radius*radius / 2.0}" iyz="0"
        izz="${mass * (3*radius*radius + width*width) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_height/2}"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="bioshuttle_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height/2}"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <xacro:box_inertia mass="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"/>
  </link>

  <!-- Insulated cargo box and lid are visualized now; actuator simulation can be added later. -->
  <link name="cargo_box_link">
    <visual>
      <geometry><box size="0.38 0.36 0.36"/></geometry>
      <material name="bioshuttle_blue"/>
    </visual>
    <collision>
      <geometry><box size="0.38 0.36 0.36"/></geometry>
    </collision>
    <xacro:box_inertia mass="5.0" x="0.38" y="0.36" z="0.36"/>
  </link>
  <joint name="cargo_box_joint" type="fixed">
    <parent link="base_link"/>
    <child link="cargo_box_link"/>
    <origin xyz="-0.06 0 0.28"/>
  </joint>

  <link name="lid_link">
    <visual>
      <geometry><box size="0.40 0.38 0.03"/></geometry>
      <material name="lid_blue"/>
    </visual>
    <collision>
      <geometry><box size="0.40 0.38 0.03"/></geometry>
    </collision>
    <xacro:box_inertia mass="0.8" x="0.40" y="0.38" z="0.03"/>
  </link>
  <joint name="lid_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lid_link"/>
    <origin xyz="-0.06 0 0.475"/>
  </joint>

  <xacro:macro name="wheel" params="name x y">
    <link name="${name}_wheel_link">
      <visual>
        <origin rpy="${PI_VALUE/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <origin rpy="${PI_VALUE/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:wheel_inertia mass="${wheel_mass}" radius="${wheel_radius}" width="${wheel_width}"/>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <origin xyz="${x} ${y} 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.15" friction="0.05"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="left" x="${axle_x}" y="${axle_y}"/>
  <xacro:wheel name="right" x="${axle_x}" y="${-axle_y}"/>
  <xacro:wheel name="rear_left" x="${-axle_x}" y="${axle_y}"/>
  <xacro:wheel name="rear_right" x="${-axle_x}" y="${-axle_y}"/>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.055" length="0.07"/></geometry>
      <material name="sensor_black"/>
    </visual>
    <xacro:box_inertia mass="0.15" x="0.10" y="0.10" z="0.07"/>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.12 0 0.52"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.035 0.10 0.05"/></geometry>
      <material name="camera_glass"/>
    </visual>
    <xacro:box_inertia mass="0.10" x="0.035" y="0.10" z="0.05"/>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.305 0 0.34"/>
  </joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-PI_VALUE/2} 0 ${-PI_VALUE/2}"/>
  </joint>

  <link name="imu_link">
    <visual>
      <geometry><box size="0.04 0.04 0.02"/></geometry>
      <material name="sensor_black"/>
    </visual>
    <xacro:box_inertia mass="0.05" x="0.04" y="0.04" z="0.02"/>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.13"/>
  </joint>

  <link name="gps_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.02"/></geometry>
      <material name="sensor_black"/>
    </visual>
    <xacro:box_inertia mass="0.05" x="0.08" y="0.08" z="0.02"/>
  </link>
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="-0.12 0 0.49"/>
  </joint>

  <xacro:macro name="range_sensor" params="name y yaw">
    <link name="${name}_range_link">
      <visual>
        <geometry><box size="0.02 0.035 0.035"/></geometry>
        <material name="sensor_black"/>
      </visual>
      <xacro:box_inertia mass="0.02" x="0.02" y="0.035" z="0.035"/>
    </link>
    <joint name="${name}_range_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_range_link"/>
      <origin xyz="0.31 ${y} 0.14" rpy="0 0 ${yaw}"/>
    </joint>
    <gazebo reference="${name}_range_link">
      <sensor name="${name}_range" type="ray">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>20</update_rate>
        <ray>
          <scan><horizontal><samples>7</samples><resolution>1</resolution><min_angle>-0.20</min_angle><max_angle>0.20</max_angle></horizontal></scan>
          <range><min>0.08</min><max>3.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise>
        </ray>
        <plugin name="${name}_range_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros><remapping>~/out:=/range/${name}</remapping></ros>
          <output_type>sensor_msgs/Range</output_type>
          <radiation_type>ultrasound</radiation_type>
          <frame_name>${name}_range_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:range_sensor name="front" y="0" yaw="0"/>
  <xacro:range_sensor name="front_left" y="0.14" yaw="0.45"/>
  <xacro:range_sensor name="front_right" y="-0.14" yaw="-0.45"/>

  <gazebo reference="base_link"><material>Gazebo/Blue</material></gazebo>
  <gazebo reference="cargo_box_link"><material>Gazebo/Blue</material></gazebo>
  <gazebo reference="lid_link"><material>Gazebo/SkyBlue</material></gazebo>

  <xacro:macro name="wheel_gazebo" params="name">
    <gazebo reference="${name}_wheel_link">
      <material>Gazebo/Black</material>
      <mu1>1.0</mu1><mu2>0.35</mu2><kp>1000000</kp><kd>10</kd>
    </gazebo>
  </xacro:macro>
  <xacro:wheel_gazebo name="left"/>
  <xacro:wheel_gazebo name="right"/>
  <xacro:wheel_gazebo name="rear_left"/>
  <xacro:wheel_gazebo name="rear_right"/>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="ray">
      <always_on>true</always_on><visualize>true</visualize><update_rate>15</update_rate>
      <pose>0 0 0 0 0 0</pose>
      <ray>
        <scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-${PI_VALUE}</min_angle><max_angle>${PI_VALUE}</max_angle></horizontal></scan>
        <range><min>0.12</min><max>20.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0</mean><stddev>0.008</stddev></noise>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=/scan</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="front_camera" type="camera">
      <always_on>true</always_on><visualize>true</visualize><update_rate>15</update_rate>
      <camera name="front_camera">
        <horizontal_fov>1.396</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>40.0</far></clip>
        <noise><type>gaussian</type><mean>0</mean><stddev>0.004</stddev></noise>
      </camera>
      <plugin name="camera_plugin" filename="libgazebo_ros_camera.so">
        <ros><namespace>/camera/color</namespace></ros>
        <camera_name>front_camera</camera_name>
        <frame_name>camera_optical_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on><visualize>false</visualize><update_rate>100</update_rate>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros><remapping>~/out:=/imu/data</remapping></ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <frame_name>imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Two wheel pairs model the real four-wheel chassis driven by one motor per side. -->
  <gazebo>
    <plugin name="bioshuttle_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros><namespace>/</namespace></ros>
      <update_rate>50</update_rate>
      <num_wheel_pairs>2</num_wheel_pairs>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>${2*axle_y}</wheel_separation>
      <wheel_separation>${2*axle_y}</wheel_separation>
      <wheel_diameter>${2*wheel_radius}</wheel_diameter>
      <wheel_diameter>${2*wheel_radius}</wheel_diameter>
      <max_wheel_torque>55.0</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odometry_source>1</odometry_source>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
    </plugin>

    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros><namespace>/</namespace></ros>
      <update_rate>30</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
