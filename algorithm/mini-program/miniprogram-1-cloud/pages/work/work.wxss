.header {
    display: flex;
    align-items: center;
    padding: 16px 20px;
    background: white;
    border-bottom: 1px solid #eee;
  }
  .back {
    font-size: 16px;
    color: #007bff;
    padding: 8px 12px;
  }
  .back:active { opacity: 0.5; }
  .header-title {
    flex: 1;
    text-align: center;
    font-weight: bold;
    font-size: 18px;
    margin-right: 40px;
  }
  .card {
    background: white;
    margin: 12px 16px;
    padding: 16px;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }
  .card-title {
    font-weight: bold;
    font-size: 17px;
    display: block;
    margin-bottom: 12px;
  }
  .status-card { background: #e9f7ef; }
  .status-text { font-size: 15px; color: #333; }
  .input {
    display: block;
    width: 100%;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 12px;
    margin-bottom: 10px;
    font-size: 15px;
    box-sizing: border-box;
  }
  .btn {
    width: 100%;
    padding: 12px;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: bold;
    color: white;
    margin-top: 4px;
  }
  .btn-green { background: #28a745; }
  .btn-green:active { background: #1e7e34; }
  .btn-red { background: #dc3545; }
  .btn-red:active { background: #bd2130; }
  .btn-orange { background: #fd7e14; flex:1; padding:10px; font-size:14px; margin-top:0; }
  .btn-blue { background: #007bff; flex:1; padding:10px; font-size:14px; margin-top:0; }
  .btn-group { display: flex; gap: 8px; }
  .result { display: block; margin-top: 10px; font-size: 14px; color: #28a745; }
  .code-card {
    margin-top: 12px;
    padding: 12px;
    border-radius: 8px;
    background: #fff7d6;
    color: #333;
  }
  .code-card text { display: block; margin: 4px 0; font-weight: bold; }
  .task-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid #f0f0f0;
  }
  .badge { background: #eee; padding: 4px 10px; border-radius: 12px; font-size: 13px; }
  .empty-tip { color: #999; text-align: center; padding: 20px 0; }
  .label {
    display: block;
    font-size: 15px;
    font-weight: 600;
    color: #333;
    margin: 12px 0 4px 0;
  }
  .input {
    display: block;
    width: 100%;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 14px 12px;          /* 上下内边距加大 */
    margin-bottom: 6px;
    font-size: 16px;             /* 字体调大 */
    box-sizing: border-box;
    background: #fafafa;
  }
  .task-status { margin-top: 5px; color: #666; font-size: 13px; }
