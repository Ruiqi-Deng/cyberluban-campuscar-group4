.container {
  padding: 30px 20px;
  background: #f5f7fa;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.header {
  text-align: center;
  margin-bottom: 30px;
}
.title {
  font-size: 40px;
  font-weight: bold;
  color: #0b2b4a;
}
.subtitle {
  font-size: 16px;
  color: #888;
  margin-top: 6px;
  display: block;
}

/* 状态卡片 */
.status-card {
  background: white;
  border-radius: 16px;
  padding: 20px 24px;
  margin-bottom: 40px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.06);
}
.status-title {
  font-size: 18px;
  font-weight: bold;
  display: block;
  margin-bottom: 10px;
}
.status-text {
  font-size: 16px;
  color: #333;
  display: block;
  margin: 4px 0;
}
.status-time {
  font-size: 12px;
  color: #aaa;
  display: block;
  margin-top: 10px;
}

/* 两个大按钮 */
.button-group {
  display: flex;
  gap: 20px;
  flex: 1;
  align-items: flex-start;
}
.big-btn {
  flex: 1;
  background: white;
  border-radius: 20px;
  padding: 30px 10px;
  text-align: center;
  box-shadow: 0 4px 16px rgba(0,0,0,0.06);
  transition: 0.2s;
}
.big-btn:active {
  opacity: 0.7;
  transform: scale(0.96);
}
.send-btn { border-top: 6px solid #28a745; }
.pickup-btn { border-top: 6px solid #dc3545; }
.btn-icon {
  font-size: 48px;
  display: block;
}
.btn-label {
  font-size: 24px;
  font-weight: bold;
  display: block;
  margin: 8px 0 4px;
}
.btn-desc {
  font-size: 14px;
  color: #888;
}